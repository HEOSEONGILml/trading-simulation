# 이 파일을 deploy/secrets.env 로 복사해서 값을 채운다 (저장소에 올라가지 않음)
# 값을 채운 뒤 Claude가 deploy/deploy.sh 로 서버에 올린다

# 스레드 (REQUEST R6): Meta 앱의 "Threads 앱 ID"와 "Threads 앱 시크릿"
THREADS_APP_ID=
THREADS_APP_SECRET=

# X (REQUEST R7): 개발자 콘솔 "Keys and tokens"의 네 값 (Read and write 권한으로 만든 것)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
